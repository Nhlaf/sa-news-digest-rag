PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
MONGODB_DATABASE=news_rag_db

# Mistral AI - Used for embeddings only during ingestion
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_EMBEDDING_MODEL=mistral-embed

# Groq - Used for news digest generation only
GROQ_API_KEY=your_groq_api_key_here
GROQ_CHAT_MODEL=openai/gpt-oss-120b

KEYWORD_ONLY_MODE=false
NEWS_SOURCE_URLS=https://www.sabcnews.com/sabcnews/category/news/south-africa/
NEWS_REQUEST_TIMEOUT_MS=15000
NEWS_MAX_ARTICLES_PER_SOURCE=20
NEWS_CHUNK_SIZE=800
NEWS_CHUNK_OVERLAP=120
PLAYWRIGHT_FALLBACK=false
